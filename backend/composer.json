{
  "name": "newsroom/cms-backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2.6",
    "symfony/framework-bundle": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/password-hasher": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.2",
    "symfony/maker-bundle": "^1.64",
    "symfony/monolog-bundle": "^4.0",
    "symfony/web-profiler-bundle": "8.1.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "symfony server:start",
    "migrate": "php bin/console doctrine:migrations:migrate --no-interaction",
    "seed": "php bin/console doctrine:fixtures:load --no-interaction",
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  }
}
